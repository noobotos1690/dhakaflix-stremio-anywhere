# ---- core -------------------------------------------------------------
PORT=7001
HOST=0.0.0.0

# Public origin of the relay. Set this when you use a named Cloudflare tunnel
# or your own domain; leave empty when the tunnel URL should be derived from
# the incoming request.
PUBLIC_URL=

# ---- streaming --------------------------------------------------------
# proxy  : relay bytes through this server (works anywhere)  [default]
# direct : hand Stremio the raw BDIX address (ISP clients only)
# both   : offer both, relayed first
STREAM_MODE=proxy

# Signs relay links. Required in production, otherwise links break on restart.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PROXY_SECRET=

# How long a relay link stays valid, in seconds (default 7 days).
PROXY_TTL=604800

# Concurrent playback sessions the upstream link can carry.
MAX_PROXY_STREAMS=8

# ---- public exposure --------------------------------------------------
# TUNNEL=1 (or `npm run public`) starts a temporary trycloudflare.com URL.
TUNNEL=0
# TUNNEL_TOKEN from `cloudflared tunnel token <name>` gives a stable hostname.
TUNNEL_TOKEN=

# ---- logging ----------------------------------------------------------
LOG_LEVEL=info
