        font-family: Theme.font;
        font-size: compact ? Theme.t-body - 1px : Theme.t-body;
        font-weight: 600;
    }

    key-pressed(event) => {
        if (!root.enabled || busy) {
            return reject;
        }
        if (event.text == " " || event.text == "\n") {
            clicked();
            return accept;
        }
        return reject;
