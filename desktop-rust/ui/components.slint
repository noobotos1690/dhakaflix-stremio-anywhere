// Shared interface pieces. Every one of them reads its colours, radii and
// spacing from the Theme global so states stay consistent across pages.

import { Theme } from "theme.slint";

export struct LogRow {
    time: string,
    level: string,
    text: string,
}

export struct DiagRow {
    label: string,
    detail: string,
    value: string,
    state: string,
}

export struct MirrorRow {
    name: string,
    host: string,
    state: string,
}

export struct ServiceInfo {
    running: bool,
    external: bool,
    status-text: string,
    status-kind: string,
    uptime: string,
    node-version: string,
    node-ok: bool,
    health-text: string,
    health-kind: string,
    mirrors-online: int,
    mirrors-total: int,
    sessions: int,
    sessions-max: int,
    detail: string,
    stream-mode: string,
    port: int,
    version: string,
}

export struct EndpointInfo {
    provider: string,
    host: string,
    manifest: string,
    local: string,
    kind: string,
    note: string,
    has-url: bool,
}

export struct CloudflareInfo {
    selected: bool,
    running: bool,
    hostname: string,
    manifest: string,
    status-text: string,
    kind: string,
    detail: string,
    has-url: bool,
    public-url: string,
}

export struct TailscaleInfo {
    selected: bool,
    installed: bool,
    service-running: bool,
    connected: bool,
    needs-login: bool,
    device: string,
    hostname: string,
    funnel-active: bool,
    funnel-target: string,
    public-url: string,
    manifest: string,
    status-text: string,
    kind: string,
    detail: string,
    has-url: bool,
}

export struct PrefsInfo {
    startup: bool,
    auto-start: bool,
    minimize-to-tray: bool,
    provider: string,
    port-text: string,
    max-streams-text: string,
    log-level: string,
    config-dir: string,
    logs-dir: string,
    version: string,
}

// --------------------------------------------------------------------- atoms

export component StatusDot inherits Rectangle {
    in property <string> kind: "idle";
    in property <length> dot-size: 7px;
    width: self.dot-size;
    height: self.dot-size;
    border-radius: self.width / 2;
    background: kind == "ok" ? Theme.success
        : kind == "warn" ? Theme.warning
        : kind == "error" ? Theme.error
        : kind == "accent" ? Theme.accent
        : Theme.idle;
}

export component Icon inherits Path {
    in property <string> kind: "overview";
    in property <color> tint: Theme.text-3;
    in property <length> icon-size: 16px;

    width: self.icon-size;
    height: self.icon-size;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: self.tint;
    stroke-width: 1.6px;
    fill: transparent;
    stroke-line-cap: round;
    stroke-line-join: round;
    commands: kind == "overview"
        ? "M4 4 H10 V10 H4 Z M14 4 H20 V10 H14 Z M4 14 H10 V20 H4 Z M14 14 H20 V20 H14 Z"
        : kind == "globe"
        ? "M12 3 A9 9 0 1 0 12 21 A9 9 0 1 0 12 3 Z M3 12 H21 M12 3 C8.6 7.6 8.6 16.4 12 21 C15.4 16.4 15.4 7.6 12 3"
        : kind == "pulse"
        ? "M3 12 H7 L9.5 5.5 L13 18.5 L15.5 12 H21"
        : kind == "logs"
        ? "M4 6 H20 M4 12 H20 M4 18 H14"
        : "M4 8 H20 M4 16 H20 M8 4.5 V11.5 M16 12.5 V19.5";
}

export component BrandMark inherits Rectangle {
    in property <length> mark-size: 26px;
    width: self.mark-size;
    height: self.mark-size;
    border-radius: Theme.r-md;
    background: Theme.accent;

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: #ffffff;
        commands: "M9.5 7 L17 12 L9.5 17 Z";
    }
}

// ------------------------------------------------------------------- buttons

export component PrimaryButton inherits FocusScope {
    in property <string> caption: "OK";
    in property <bool> compact: false;
    in property <bool> busy: false;
    callback clicked;

    min-width: max(88px, label.preferred-width + 30px);
    min-height: compact ? 26px : 32px;
    horizontal-stretch: 0;
    vertical-stretch: 0;

    ta := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: root.enabled && !busy ? pointer : default;
        clicked => {
            if (root.enabled && !root.busy) {
                root.clicked();
            }
        }
    }

    bg := Rectangle {
        width: 100%;
        height: 100%;
        border-radius: Theme.r-md;
        background: Theme.accent;
        animate background { duration: 90ms; }

        states [
            hovered when ta.has-hover && root.enabled && !root.busy: {
                background: Theme.accent-hover;
            }
            pressed when ta.pressed && root.enabled && !root.busy: {
                background: Theme.accent-press;
            }
            off when !root.enabled || root.busy: {
                background: Theme.surface-2;
            }
        ]
    }

    ring := Rectangle {
        width: 100%;
        height: 100%;
        border-radius: Theme.r-md;
        border-width: 1px;
        border-color: root.has-focus ? Theme.accent-line : transparent;
    }

    label := Text {
        width: 100%;
        height: 100%;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: root.busy ? "Working…" : root.caption;
        color: root.enabled && !root.busy ? Theme.on-accent : Theme.text-3;
        font-family: Theme.font;
        font-size: compact ? Theme.t-body - 1px : Theme.t-body;
        font-weight: 600;
    }

    key-pressed(event) => {
        if (!root.enabled || busy) {
            return reject;
        }
        if (event.text == " " || event.text == "\n") {
            clicked();
            return accept;
        }
        return reject;
    }
}

export component SecondaryButton inherits FocusScope {
    in property <string> caption: "Action";
    in property <bool> compact: false;
    callback clicked;

    min-width: max(76px, label.preferred-width + 26px);
    min-height: compact ? 26px : 32px;
    horizontal-stretch: 0;
    vertical-stretch: 0;

    ta := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }

    bg := Rectangle {
        width: 100%;
        height: 100%;
        border-radius: Theme.r-md;
        background: transparent;
        border-width: 1px;
        border-color: Theme.border;

        states [
            hovered when ta.has-hover && root.enabled: {
                background: Theme.hover;
                border-color: Theme.border-strong;
            }
            pressed when ta.pressed && root.enabled: {
                background: Theme.surface-2;
            }
            off when !root.enabled: {
                background: transparent;
                border-color: Theme.divider;
            }
        ]
    }

    ring := Rectangle {
        width: 100%;
        height: 100%;
        border-radius: Theme.r-md;
        border-width: 1px;
        border-color: root.has-focus ? Theme.accent-line : transparent;
    }

    label := Text {
        width: 100%;
        height: 100%;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: root.caption;
        color: root.enabled ? Theme.text : Theme.text-3;
        font-family: Theme.font;
        font-size: compact ? Theme.t-body - 1px : Theme.t-body;
        font-weight: 500;
    }

    key-pressed(event) => {
        if (!root.enabled) {
            return reject;
        }
        if (event.text == " " || event.text == "\n") {
            clicked();
            return accept;
        }
        return reject;
    }
}

