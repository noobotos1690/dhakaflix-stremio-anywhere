    in property <string> caption: "Stop";
    in property <bool> compact: false;
    in property <bool> busy: false;
    callback clicked;

    min-width: max(88px, label.preferred-width + 30px);
    min-height: compact ? 26px : 32px;
    horizontal-stretch: 0;
    vertical-stretch: 0;

    ta := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: root.enabled && !busy ? pointer : default;
